{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@renderblocks/blocks": ["../games/blocks/src/index.ts"],
      "@renderblocks/blocks/module": ["../games/blocks/src/module.ts"],
      "@renderblocks/shapes": ["../games/shapes/src/index.ts"],
      "@renderblocks/shapes/module": ["../games/shapes/src/module.ts"],
      "@renderblocks/combos": ["../games/combos/src/index.ts"],
      "@renderblocks/combos/module": ["../games/combos/src/module.ts"],
      "@renderblocks/times": ["../games/times/src/index.ts"],
      "@renderblocks/times/module": ["../games/times/src/module.ts"],
      "@renderblocks/add": ["../games/add/src/index.ts"],
      "@renderblocks/add/module": ["../games/add/src/module.ts"],
      "@renderblocks/subtract": ["../games/subtract/src/index.ts"],
      "@renderblocks/subtract/module": ["../games/subtract/src/module.ts"],
      "@renderblocks/divide": ["../games/divide/src/index.ts"],
      "@renderblocks/divide/module": ["../games/divide/src/module.ts"],
      "@renderblocks/tasks": ["../games/tasks/src/index.ts"],
      "@renderblocks/tasks/module": ["../games/tasks/src/module.ts"],
      "@renderblocks/graph": ["../games/graph/src/index.ts"],
      "@renderblocks/graph/module": ["../games/graph/src/module.ts"],
      "@renderblocks/numline": ["../games/numline/src/index.ts"],
      "@renderblocks/numline/module": ["../games/numline/src/module.ts"],
      "@renderblocks/drill": ["../drill/src/index.ts"],
      "@renderblocks/kernel": ["../kernel/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../games/blocks/src",
    "../games/shapes/src",
    "../games/combos/src",
    "../games/times/src",
    "../games/add/src",
    "../games/subtract/src",
    "../games/divide/src",
    "../games/tasks/src",
    "../games/graph/src",
    "../games/numline/src",
    "../drill/src",
    "../kernel/src"
  ]
}
