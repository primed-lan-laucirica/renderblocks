{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@renderblocks/blocks": ["../games/blocks/src/index.ts"],
      "@renderblocks/blocks/module": ["../games/blocks/src/module.ts"],
      "@renderblocks/shapes": ["../games/shapes/src/index.ts"],
      "@renderblocks/shapes/module": ["../games/shapes/src/module.ts"],
      "@renderblocks/combos": ["../games/combos/src/index.ts"],
      "@renderblocks/combos/module": ["../games/combos/src/module.ts"],
      "@renderblocks/times": ["../games/times/src/index.ts"],
      "@renderblocks/times/module": ["../games/times/src/module.ts"],
      "@renderblocks/kernel": ["../kernel/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../games/blocks/src",
    "../games/shapes/src",
    "../games/combos/src",
    "../games/times/src",
    "../kernel/src"
  ]
}
